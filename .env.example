# Cadena de conexión de Neon/PostgreSQL (usar la URL con pooler en producción)
DATABASE_URL="postgresql://usuario:contraseña@host/base?sslmode=require"

# Secreto de al menos 32 caracteres. Generar con: npx auth@latest secret
BETTER_AUTH_SECRET="reemplazar-por-un-secreto-seguro-de-al-menos-32-caracteres"

# URL pública de la aplicación
BETTER_AUTH_URL="http://localhost:3000"

# DEETA AI (opcional: el resto de DEETA funciona sin estas variables)
AI_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
DEETA_AI_TIMEOUT_MS="15000"
DEETA_AI_REQUESTS_PER_MINUTE="8"
DEETA_AI_MONTHLY_LIMIT="100"

# WhatsApp de ayuda y sugerencias (opcional). Formato internacional, ej.: 5491112345678.
# Es público: aparece en los enlaces. Sin este valor, los accesos a WhatsApp se ocultan.
# Al cambiarlo hay que volver a desplegar, porque se incluye en el build.
NEXT_PUBLIC_SUPPORT_WHATSAPP=""

# Perfil público de DEETA en X/Twitter (opcional, contacto secundario). Usuario (deeta o @deeta)
# o URL del perfil (https://x.com/deeta). Sin este valor, el enlace no se muestra.
NEXT_PUBLIC_SOCIAL_X=""

# Solo para ejecutar pruebas de integración contra una rama Neon no productiva
DEETA_TEST_DATABASE_HOST="host-exacto-de-la-rama-de-pruebas"
